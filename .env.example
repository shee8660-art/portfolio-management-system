# --- Database (PostgreSQL on Supabase — see README step 1) ---
# Use the Transaction pooler connection string (port 6543) from
# Supabase Dashboard → Project Settings → Database → Connection string.
# Replace [YOUR-PASSWORD] with your Supabase database password.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Admin login ---
# Default admin username is "admin". Change the password immediately
# after your first login (Vercel → Project → Settings → Environment
# Variables → ADMIN_PASSWORD, then Redeploy).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Optional: instead of a plain password, set a bcrypt hash of the password
# (generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))").
# When ADMIN_PASSWORD_HASH is set it takes priority over ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=

# --- Optional ---
# Public base URL of the deployed site, e.g. https://my-portfolios.vercel.app
NEXT_PUBLIC_SITE_URL=
# Secret used to sign the admin session cookie. If unset, ADMIN_PASSWORD is used.
# Set a long random value in production for extra safety.
SESSION_SECRET=
